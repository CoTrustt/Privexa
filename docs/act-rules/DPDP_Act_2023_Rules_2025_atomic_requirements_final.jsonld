    {
      "@id": "rule:21",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "provisionLevel": "rule",
      "ruleNumber": 21,
      "title": "Terms and conditions of appointment and service of officers and employees of Board",
      "sourcePages": {
        "start": 8,
        "end": 8
      },
      "extractedSourceText": "21. Terms and conditions of appointment and service of officers and employees of Board .— (1) The\nBoard may, with previous approval of the Central Government, appoint such officers and employees as it\nmay deem necessary for the efficient discharge of its functions under the provisions of the Act.\n(2) The terms and conditions of service of officers and employees of the Board shall be such as are\nspecified in Sixth Schedule.",
      "bodyText": "(1) The\nBoard may, with previous approval of the Central Government, appoint such officers and employees as it\nmay deem necessary for the efficient discharge of its functions under the provisions of the Act.\n(2) The terms and conditions of service of officers and employees of the Board shall be such as are\nspecified in Sixth Schedule.",
      "leadInText": "",
