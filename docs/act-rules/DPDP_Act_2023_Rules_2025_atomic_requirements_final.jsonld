      "implementsOrRefines": [
        "act:section:10:subsection:2:clause:c"
      ],
      "modalPhrase": "shall",
      "sourceModalIndex": 1,
      "normalizedRequirementText": "significant data fiduciary shall observe due diligence to verify that technical measures including algorithmic software adopted by it for hosting, display, uploading, modification, publishing, transmission, storage, updating or sharing of personal data processed by it are not likely to pose a risk to the rights of Data Principals."
    },
    {
      "@id": "rule:13:subrule:4:atomic:explicit:1",
      "@type": [
