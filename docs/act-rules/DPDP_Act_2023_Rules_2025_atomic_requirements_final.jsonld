      "marker": "(d)",
      "markerToken": "d",
      "depth": 2,
      "order": 4,
      "sourceText": "has acquired such financial or other interest, as is likely to affect prejudicially\nher functions as a Member; or",
      "crossReferences": []
    },
    {
      "@id": "act:section:21:subsection:1:clause:e",
      "@type": "dpdp:LegalProvision",
