      "provisionLevel": "clause",
      "marker": "(f)",
      "markerToken": "f",
      "depth": 2,
      "order": 6,
      "sourceText": "public order.",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:10",
      "rootProvision": "act:section:10",
      "provisionLevel": "subsection",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 7,
      "sourceText": "The Significant Data Fiduciary shall—",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:2:clause:a",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:10:subsection:2",
