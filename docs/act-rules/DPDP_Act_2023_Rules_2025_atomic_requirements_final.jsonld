    {
      "@id": "act:section:2:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:a",
      "term": "Appellate Tribunal",
      "definitionType": "direct",
      "sourceText": "“Appellate Tribunal” means the Telecom Disputes Settlement and Appellate Tribunal established under section 14 of the Telecom Regulatory Authority of India Act, 1997;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:b:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:b",
      "term": "automated",
      "definitionType": "direct",
      "sourceText": "“automated” means any digital process capable of operating automatically in response to instructions given or otherwise for the purpose of processing data;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:c:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:c",
      "term": "Board",
      "definitionType": "direct",
      "sourceText": "“Board” means the Data Protection Board of India established by the Central Government under section 18;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:d:definition:4",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:d",
      "term": "certain legitimate uses",
      "definitionType": "direct",
      "sourceText": "“certain legitimate uses” means the uses referred to in section 7;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:e:definition:5",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:e",
      "term": "Chairperson",
      "definitionType": "direct",
      "sourceText": "“Chairperson” means the Chairperson of the Board;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:f:definition:6",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:f",
      "term": "child",
      "definitionType": "direct",
      "sourceText": "“child” means an individual who has not completed the age of eighteen years;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:g:definition:7",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:g",
      "term": "Consent Manager",
      "definitionType": "direct",
      "sourceText": "“Consent Manager” means a person registered with the Board, who acts as a single point of contact to enable a Data Principal to give, manage, review and withdraw her consent through an accessible, transparent and interoperable platform;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:h:definition:8",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:h",
      "term": "data",
      "definitionType": "direct",
      "sourceText": "“data” means a representation of information, facts, concepts, opinions or instructions in a manner suitable for communication, interpretation or processing by human beings or by automated means;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:i:definition:9",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:i",
      "term": "Data Fiduciary",
      "definitionType": "direct",
      "sourceText": "“Data Fiduciary” means any person who alone or in conjunction with other persons determines the purpose and means of processing of personal data;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:j:definition:10",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:j",
      "term": "Data Principal",
      "definitionType": "direct",
      "sourceText": "“Data Principal” means the individual to whom the personal data relates and where such individual is— a child, includes the parents or lawful guardian of such a child; a person with disability, includes her lawful guardian, acting on her behalf;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:k:definition:11",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:k",
      "term": "Data Processor",
      "definitionType": "direct",
      "sourceText": "“Data Processor” means any person who processes personal data on behalf of a Data Fiduciary;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:l:definition:12",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:l",
      "term": "Data Protection Officer",
      "definitionType": "direct",
      "sourceText": "“Data Protection Officer” means an individual appointed by the Significant Data Fiduciary under clause (a) of sub-section (2) of section 10;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:m:definition:13",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:m",
      "term": "digital office",
      "definitionType": "direct",
      "sourceText": "“digital office” means an office that adopts an online mechanism wherein the proceedings, from receipt of intimation or complaint or reference or directions or appeal, as the case may be, to the disposal thereof, are conducted in online or digital mode;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:n:definition:14",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:n",
      "term": "digital personal data",
      "definitionType": "direct",
      "sourceText": "“digital personal data” means personal data in digital form;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:o:definition:15",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:o",
      "term": "gain",
      "definitionType": "direct",
      "sourceText": "“gain” means— a gain in property or supply of services, whether temporary or permanent; or an opportunity to earn remuneration or greater remuneration or to gain a financial advantage otherwise than by way of legitimate remuneration;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:p:definition:16",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:p",
      "term": "loss",
      "definitionType": "direct",
      "sourceText": "“loss” means— a loss in property or interruption in supply of services, whether temporary or permanent; or a loss of opportunity to earn remuneration or greater remuneration or to gain a financial advantage otherwise than by way of legitimate remuneration;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:q:definition:17",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:q",
      "term": "Member",
      "definitionType": "direct",
      "sourceText": "“Member” means a Member of the Board and includes the Chairperson;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:r:definition:18",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:r",
      "term": "notification",
      "definitionType": "direct",
      "sourceText": "“notification” means a notification published in the Official Gazette and the expressions “notify” and “notified” shall be construed accordingly;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:s:definition:19",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:s",
      "term": "person",
      "definitionType": "inclusive",
      "sourceText": "“person” includes— an individual; a Hindu undivided family; a company; a firm; an association of persons or a body of individuals, whether incorporated or not; the State; and every artificial juristic person, not falling within any of the preceding sub-clauses;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:t:definition:20",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:t",
      "term": "personal data",
      "definitionType": "direct",
      "sourceText": "“personal data” means any data about an individual who is identifiable by or in relation to such data;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:u:definition:21",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:u",
      "term": "personal data breach",
      "definitionType": "direct",
      "sourceText": "“personal data breach” means any unauthorised processing of personal data or accidental disclosure, acquisition, sharing, use, alteration, destruction or loss of access to personal data, that compromises the confidentiality, integrity or availability of personal data;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:v:definition:22",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:v",
      "term": "prescribed",
      "definitionType": "direct",
      "sourceText": "“prescribed” means prescribed by rules made under this Act;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:w:definition:23",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:w",
      "term": "proceeding",
      "definitionType": "direct",
      "sourceText": "“proceeding” means any action taken by the Board under the provisions of this Act;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:x:definition:24",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:x",
      "term": "processing",
      "definitionType": "direct",
      "sourceText": "“processing” in relation to personal data, means a wholly or partly automated operation or set of operations performed on digital personal data, and includes operations such as collection, recording, organisation, structuring, storage, adaptation, retrieval, use, alignment or combination, indexing, sharing, disclosure by transmission, dissemination or otherwise making available, restriction, erasure or destruction;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:y:definition:25",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:y",
      "term": "she",
      "definitionType": "inclusive",
      "sourceText": "“she” in relation to an individual includes the reference to such individual irrespective of gender;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:z:definition:26",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:z",
      "term": "Significant Data Fiduciary",
      "definitionType": "direct",
      "sourceText": "“Significant Data Fiduciary” means any Data Fiduciary or class of Data Fiduciaries as may be notified by the Central Government under section 10;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:za:definition:27",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:za",
      "term": "specified purpose",
      "definitionType": "direct",
      "sourceText": "“specified purpose” means the purpose mentioned in the notice given by the Data Fiduciary to the Data Principal in accordance with the provisions of this Act and the rules made thereunder; and",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:2:clause:zb:definition:28",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:2:clause:zb",
      "term": "State",
      "definitionType": "direct",
      "sourceText": "“State” means the State as defined under article 12 of the Constitution.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:4:subsection:2:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:4:subsection:2",
      "term": "lawful purpose",
      "definitionType": "direct",
      "sourceText": "For the purposes of this section, the expression “lawful purpose” means any purpose which is not expressly forbidden by law.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:7:interpretation:1:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:7:interpretation:1",
      "term": "disaster",
      "definitionType": "incorporated_reference",
      "sourceText": "Explanation.—For the purposes of this clause, the expression “disaster” shall have the same meaning as assigned to it in clause (d) of section 2 of the Disaster Management Act, 2005; or",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:9:interpretation:1:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:9:interpretation:1",
      "term": "consent of the parent",
      "definitionType": "inclusive",
      "sourceText": "Explanation.—For the purpose of this sub-section, the expression “consent of the parent” includes the consent of lawful guardian, wherever applicable.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:14:subsection:2:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:14:subsection:2",
      "term": "incapacity",
      "definitionType": "direct",
      "sourceText": "For the purposes of this section, the expression “incapacity” means inability to exercise the rights of the Data Principal under the provisions of this Act or the rules made thereunder due to unsoundness of mind or infirmity of body.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:17:interpretation:1:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:17:interpretation:1",
      "term": "default",
      "definitionType": "incorporated_reference",
      "sourceText": "Explanation.—For the purposes of this clause, the expressions “default” and “financial institution” shall have the meanings respectively assigned to them in sub-sections (12) and (14) of section 3 of the Insolvency and Bankruptcy Code, 2016.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:17:interpretation:1:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:17:interpretation:1",
      "term": "financial institution",
      "definitionType": "incorporated_reference",
      "sourceText": "Explanation.—For the purposes of this clause, the expressions “default” and “financial institution” shall have the meanings respectively assigned to them in sub-sections (12) and (14) of section 3 of the Insolvency and Bankruptcy Code, 2016.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:17:interpretation:2:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:17:interpretation:2",
      "term": "startup",
      "definitionType": "direct",
      "sourceText": "Explanation.—For the purposes of this sub-section, the term “startup” means a private limited company or a partnership firm or a limited liability partnership incorporated in India, which is eligible to be and is recognised as such in accordance with the criteria and process notified by the department to which matters relating to startups are allocated in the Central Government.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:37:subsection:3:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:37:subsection:3",
      "term": "computer resource",
      "definitionType": "incorporated_reference",
      "sourceText": "For the purposes of this section, the expressions “computer resource”, “information” and “intermediary” shall have the meanings respectively assigned to them in the Information Technology Act, 2000.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:37:subsection:3:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:37:subsection:3",
      "term": "information",
      "definitionType": "incorporated_reference",
      "sourceText": "For the purposes of this section, the expressions “computer resource”, “information” and “intermediary” shall have the meanings respectively assigned to them in the Information Technology Act, 2000.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "act:section:37:subsection:3:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:37:subsection:3",
      "term": "intermediary",
      "definitionType": "incorporated_reference",
      "sourceText": "For the purposes of this section, the expressions “computer resource”, “information” and “intermediary” shall have the meanings respectively assigned to them in the Information Technology Act, 2000.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:2:subrule:1:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:2:subrule:1:clause:a",
      "term": "Act",
      "definitionType": "direct",
      "sourceText": "“Act” means the Digital Personal Data Protection Act, 2023 (22 of 2023);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:2:subrule:1:clause:b:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:2:subrule:1:clause:b",
      "term": "techno-legal measures",
      "definitionType": "direct",
      "sourceText": "“techno-legal measures” means as referred to under rules 20 and 22;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:2:subrule:1:clause:c:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:2:subrule:1:clause:c",
      "term": "user account",
      "definitionType": "direct",
      "sourceText": "“user account” means the online account registered by the Data Principal with the Data Fiduciary, and includes any profiles, pages, handles, email address, mobile number and other similar presences by means of which such Data Principal is able to access the services of such Data Fiduciary; and",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:2:subrule:1:clause:d:definition:4",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:2:subrule:1:clause:d",
      "term": "verifiable consent",
      "definitionType": "direct",
      "sourceText": "“verifiable consent” means a consent as specified in rule 10 or 11.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:6:subrule:2:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:6:subrule:2",
      "term": "computer resource",
      "definitionType": "incorporated_reference",
      "sourceText": "In this rule, the expression “computer resource” shall have the same meaning as is assigned to it in Information Technology Act, 2000 (21 of 2000).",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:10:subrule:2:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:10:subrule:2:clause:a",
      "term": "adult",
      "definitionType": "direct",
      "sourceText": "“adult” shall mean an individual who has completed the age of eighteen years;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:10:subrule:2:clause:b:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:10:subrule:2:clause:b",
      "term": "authorised entity",
      "definitionType": "direct",
      "sourceText": "“authorised entity\" shall mean — an entity entrusted by law or by the Central Government or by the State Government with the issuance of details of the identity and age or a virtual token mapped to such details; or a person appointed or permitted by the entity specified under clause (i), for such issuance, and also includes details of identity and age or token made available and verified by a Digital Locker Service Provider;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:10:subrule:2:clause:c:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:10:subrule:2:clause:c",
      "term": "Digital Locker service provider",
      "definitionType": "direct",
      "sourceText": "“Digital Locker service provider” shall mean such intermediary, including a body corporate or an agency of the appropriate Government, as may be notified by the Central Government, in accordance with the rules made in this regard under the Information Technology Act, 2000 (21 of 2000);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:11:subrule:2:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:11:subrule:2:clause:a",
      "term": "designated authority",
      "definitionType": "direct",
      "sourceText": "“designated authority” shall mean an authority designated under section 15 of the Rights of Persons with Disabilities Act, 2016 (49 of 2016) to support persons with disabilities in exercise of their legal capacity;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:11:subrule:2:clause:b:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:11:subrule:2:clause:b",
      "term": "law applicable to guardianship",
      "definitionType": "direct",
      "sourceText": "“law applicable to guardianship” shall mean, — in relation to an individual who has long term physical, mental, intellectual or sensory impairment which, in interaction with barriers, hinders her full and effective participation in society equally with others and who despite being provided adequate and appropriate support is unable to take legally binding decisions, the provisions of law contained in Rights of Persons with Disabilities Act, 2016 (49 of 2016) and the rules made thereunder; and in relation to a person who is suffering from any of the conditions relating to autism, cerebral palsy, mental retardation or a combination of such conditions and includes a person suffering from severe multiple disability, the provisions of law of the National Trust for the Welfare of Persons with Autism, Cerebral Palsy, Mental Retardation and Multiple Disabilities Act, 1999 (44 of 1999) and the rules made thereunder;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:11:subrule:2:clause:c:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:11:subrule:2:clause:c",
      "term": "local level committee",
      "definitionType": "direct",
      "sourceText": "“local level committee” shall mean a local level committee constituted under section 13 of the National Trust for the Welfare of Persons with Autism, Cerebral Palsy, Mental Retardation and Multiple Disabilities Act, 1999 (44 of 1999);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:11:subrule:2:clause:d:definition:4",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:11:subrule:2:clause:d",
      "term": "person with disability",
      "definitionType": "inclusive",
      "sourceText": "“person with disability” shall mean and include— an individual who has long term physical, mental, intellectual or sensory impairment which, in interaction with barriers, hinders her full and effective participation in society equally with others and who, despite being provided adequate and appropriate support, is unable to take legally binding decisions; and an individual who is suffering from any of the conditions relating to autism, cerebral palsy, mental retardation or a combination of any two or more of such conditions and includes an individual suffering from severe multiple disability and who, despite being provided adequate and appropriate support, is unable to take legally binding decisions.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:13:subrule:5:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:13:subrule:5",
      "term": "committee",
      "definitionType": "direct",
      "sourceText": "In this rule, “committee” means a committee constituted by the Central Government for the purpose of this rule, which shall include officials from the Ministry of Electronics and Technology and may include officials from other Ministries or Department of the Central Government.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:14:subrule:5:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:14:subrule:5",
      "term": "identifier",
      "definitionType": "direct",
      "sourceText": "In this rule, the expression “identifier” shall mean any sequence of characters issued by the Data Fiduciary to identify the Data Principal and includes a customer identification file number, customer acquisition form number, application reference number, enrolment ID, email address, mobile number or licence number that enables such identification.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rule:23:subrule:3:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:23:subrule:3",
      "term": "intermediary",
      "definitionType": "incorporated_reference",
      "sourceText": "For the purposes of this rule, the expression “intermediary” shall have the same meaning as assigned to it in the Information Technology Act, 2000 (21 of 2000).",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:a",
      "term": "body corporate",
      "definitionType": "inclusive",
      "sourceText": "the expression “body corporate” shall include a company, a body corporate as defined under clause (11) of section 2 of the Companies Act, 2013 (18 of 2013), a firm, a financial institution, a scheduled bank or a public sector enterprise established or constituted by or under any Central Act, Provincial Act or State Act, and any other incorporated association of persons or body of individuals;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:b:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:b",
      "term": "company",
      "definitionType": "incorporated_reference",
      "sourceText": "the expressions “company”, “control”, “director” and “key managerial personnel” shall have the same meanings as are respectively assigned to them in the Companies Act, 2013 (18 of 2013);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:b:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:b",
      "term": "control",
      "definitionType": "incorporated_reference",
      "sourceText": "the expressions “company”, “control”, “director” and “key managerial personnel” shall have the same meanings as are respectively assigned to them in the Companies Act, 2013 (18 of 2013);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:b:definition:4",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:b",
      "term": "director",
      "definitionType": "incorporated_reference",
      "sourceText": "the expressions “company”, “control”, “director” and “key managerial personnel” shall have the same meanings as are respectively assigned to them in the Companies Act, 2013 (18 of 2013);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:b:definition:5",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:b",
      "term": "key managerial personnel",
      "definitionType": "incorporated_reference",
      "sourceText": "the expressions “company”, “control”, “director” and “key managerial personnel” shall have the same meanings as are respectively assigned to them in the Companies Act, 2013 (18 of 2013);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:c:definition:6",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:c",
      "term": "net worth",
      "definitionType": "direct",
      "sourceText": "the expression “net worth” shall mean the aggregate value of total assets as reduced by the value of liabilities of the Consent Manager as appearing in its books of accounts; and",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:d:definition:7",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:d",
      "term": "promoter",
      "definitionType": "incorporated_reference",
      "sourceText": "the expressions “promoter” and “senior management” shall have the same meanings as are respectively assigned to them in the Companies Act, 2013 (18 or 2013).",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:first:note:clause:d:definition:8",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:first:note:clause:d",
      "term": "senior management",
      "definitionType": "incorporated_reference",
      "sourceText": "the expressions “promoter” and “senior management” shall have the same meanings as are respectively assigned to them in the Companies Act, 2013 (18 or 2013).",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:third:note:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:third:note:clause:a",
      "term": "e-commerce entity",
      "definitionType": "direct",
      "sourceText": "“e-commerce entity” means any person who owns, operates or manages a digital facility or platform for e -commerce as defined in the Consumer Protection Act, 2019 (35 of 2019), but does not include a seller offering her goods or services for sale on a marketplace e -commerce entity as defined in the said Act;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:third:note:clause:b:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:third:note:clause:b",
      "term": "online gaming intermediary",
      "definitionType": "direct",
      "sourceText": "“online gaming intermediary” means any intermediary who enables the users of its computer resource to access one or more online games;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:third:note:clause:c:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:third:note:clause:c",
      "term": "social media intermediary",
      "definitionType": "direct",
      "sourceText": "“social media intermediary” means an intermediary as defined in clause (w) of sub-rule (1) of rule 2 of the Information Technology (Intermediary Guidelines and Digital Media Ethics Code) Rules, 2021; and",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:third:note:clause:d:definition:4",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:third:note:clause:d",
      "term": "user",
      "definitionType": "composite",
      "sourceText": "“user”, in relation to— an e-commerce entity, means any person who accesses or avails any computer resource of an e-commerce entity; and an online gaming intermediary or a social media intermediary, means any person who accesses or avails of any computer resource of an intermediary for the purpose of hosting, publishing, sharing, transacting, viewing, displaying, downloading or uploading information.",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:a:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:a",
      "term": "advertisement",
      "definitionType": "incorporated_reference",
      "sourceText": "“advertisement” shall have the same meaning as is assigned to it in the Consumer Protection Act, 2019 (35 of 2019).",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:a:occurrence:2:definition:2",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:a:occurrence:2",
      "term": "allied healthcare professional",
      "definitionType": "incorporated_reference",
      "sourceText": "“allied healthcare professional” shall have the same meaning as is assigned to it in the clause (d) of section 2 of the National Commission for Allied and Healthcare Professions Act, 2021 (14 of 2021);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:b:definition:3",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:b",
      "term": "clinical establishment",
      "definitionType": "incorporated_reference",
      "sourceText": "“clinical establishment” shall have the same meaning as assigned to it in the clause (c) of section 2 of the Clinical Establishments (Registration and Regulation) Act, 2010 (23 of 2010);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:c:definition:4",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:c",
      "term": "educational institution",
      "definitionType": "inclusive",
      "sourceText": "“educational institution” shall mean and include an institution of learning that imparts education, including vocational education;",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:d:definition:5",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:d",
      "term": "healthcare professional",
      "definitionType": "incorporated_reference",
      "sourceText": "“healthcare professional” shall have the same meaning as is assigned to it in clause (j) of section 2 of the National Commission for Allied and Healthcare Professions Act, 2021 (14 of 2021);",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:e:definition:6",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:e",
      "term": "health services",
      "definitionType": "direct",
      "sourceText": "“health services” shall mean the services required to be provided by a healthcare professional as referred to in clause (j) of section 2 of the National Commission for Allied and Healthcare Professions Act, 2021 (14 of 2021); and",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fourth:note:clause:f:definition:7",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fourth:note:clause:f",
      "term": "mental health establishment",
      "definitionType": "incorporated_reference",
      "sourceText": "“mental health establishment” shall have the same meaning as is assigned to it in clause (p) of sub- section (1) of section 2 of the Mental Healthcare Act, 2017 (10 of 2017).",
      "reviewStatus": "source-derived"
    },
    {
      "@id": "rules:schedule:fifth:paragraph:9:definition:1",
      "@type": "dpdp:Definition",
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rules:schedule:fifth:paragraph:9",
      "term": "pay matrix",
      "definitionType": "direct",
      "sourceText": "In this Schedule, “pay matrix” shall mean the pay matrix specified in Annexure I to the Central Government’s Resolution published in the Official Gazette vide Notification no. 1-2/2016-IC, dated the 25th July, 2016.",
      "reviewStatus": "source-derived"
    },
    {
