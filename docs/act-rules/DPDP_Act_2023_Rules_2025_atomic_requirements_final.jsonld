    {
      "@id": "rules:schedule:seventh:row:1",
      "@type": "dpdp:AuthorizationRow",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:seventh",
      "rowNumber": 1,
      "purpose": "Use, by the State or any of its instrumentalities, of\npersonal data of a Data Principal in the interest of\nsovereignty and integrity of India or security of\nthe State.",
      "authorisedPersonText": "Such officer of the State or of any of its\ninstrumentalities notified under clause (a) of\nsub-section (2) of section 17 of the Act, as the\nCentral Government or the head of such\ninstrumentality, as the case may be, may\ndesignate in this behalf.",
      "crossReferences": [
        {
          "referenceKind": "section",
          "sourcePhrase": "section 17",
          "targetDocument": "doc:dpdp-act-2023",
          "target": "act:section:17",
          "resolutionStatus": "internal-resolved-root",
          "context": "Such officer of the State or of any of its instrumentalities notified under clause (a) of sub-section (2) of section 17 of the Act, as the Central Government or the head of such instrumentality, as the case may be, may designate in this behalf."
        }
      ]
    },
    {
      "@id": "rules:schedule:seventh:row:2",
      "@type": "dpdp:AuthorizationRow",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:seventh",
      "rowNumber": 2,
      "purpose": "Use, by the State or any of its instrumentalities, of\npersonal data of a Data Principal for the following\npurposes, namely: —\n(i) performance of any function under any\nlaw for the time being in force in India; or\n(ii) disclosure of any information for\nfulfilling any obligation under any law for\nthe time being in force in India.",
      "authorisedPersonText": "Person authorised under applicable law.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:seventh:row:3",
      "@type": "dpdp:AuthorizationRow",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:seventh",
      "rowNumber": 3,
      "purpose": "Carrying out assessment for notifying any Data\nFiduciary or class of Data Fiduciaries as\nSignificant Data Fiduciary.",
      "authorisedPersonText": "Such officer of the Central Government, in the\nMinistry of Electronics and Information\nTechnology, as the Secretary in charge of the\nsaid Ministry may designate in this behalf.",
      "crossReferences": []
    },
    {
