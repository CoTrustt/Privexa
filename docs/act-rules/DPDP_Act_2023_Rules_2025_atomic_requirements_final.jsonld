      "provisionLevel": "clause",
      "marker": "(c)",
      "markerToken": "c",
      "depth": 2,
      "order": 5,
      "sourceText": "not apply to—",
      "crossReferences": []
    },
    {
      "@id": "act:section:3:clause:c:subclause:i",
      "@type": "dpdp:LegalProvision",
