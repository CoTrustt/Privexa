      "provisionLevel": "clause",
      "marker": "(a)",
      "markerToken": "a",
      "depth": 2,
      "order": 8,
      "sourceText": "appoint a Data Protection Officer who shall—",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:2:clause:a:subclause:i",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
