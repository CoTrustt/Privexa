    {
      "@id": "rule:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "provisionLevel": "rule",
      "ruleNumber": 1,
      "title": "Short title and commencement",
      "sourcePages": {
        "start": 1,
        "end": 1
      },
      "extractedSourceText": "1. Short title and commencement . — (1) These rules may be called the Digital Personal Data Protection\nRules, 2025.\n(2) Rules 1, 2 and 17 to 21 shall come into force on the date of their publication in the Official Gazette.\n(3) Rule 4 shall come into force one year after the date of publication of this Gazette.\n(4) Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication\nof this Gazette.",
      "bodyText": "(1) These rules may be called the Digital Personal Data Protection\nRules, 2025.\n(2) Rules 1, 2 and 17 to 21 shall come into force on the date of their publication in the Official Gazette.\n(3) Rule 4 shall come into force one year after the date of publication of this Gazette.\n(4) Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication\nof this Gazette.",
      "leadInText": "",
      "commencement": {
        "basis": "Rule 1",
        "effectiveDateDerived": "2025-11-13"
      },
      "implementsOrOperationalises": [
        "act:section:40"
      ],
      "delegationBasis": [
        "act:section:40:subsection:1"
      ],
      "crossReferences": [
        {
          "referenceKind": "rule",
          "sourcePhrase": "Rules 1",
          "targetDocument": "doc:dpdp-rules-2025",
          "target": "rule:1",
          "resolutionStatus": "internal-resolved-root",
          "context": "(2) Rules 1, 2 and 17 to 21 shall come into force on the date of their publication in the Official Gazette."
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "Rule 4",
          "targetDocument": "doc:dpdp-rules-2025",
          "target": "rule:4",
          "resolutionStatus": "internal-resolved-root",
          "context": "(3) Rule 4 shall come into force one year after the date of publication of this Gazette."
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "Rules 3",
          "targetDocument": "doc:dpdp-rules-2025",
          "target": "rule:3",
          "resolutionStatus": "internal-resolved-root",
          "context": "(4) Rules 3, 5 to 16, 22 and 23 shall come into force eighteen months after the date of publication of this Gazette."
        }
      ],
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative"
    },
