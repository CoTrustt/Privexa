    {
      "@id": "act:section:7:unstructured:1",
      "@type": "dpdp:TextBlock",
      "parent": "act:section:7",
      "sourceText": "A Data Fiduciary may process personal data of a Data Principal for any of following",
      "order": 0,
      "document": "doc:dpdp-act-2023"
    },
