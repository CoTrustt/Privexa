    },
    {
      "@id": "act:section:2:clause:u",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(u)",
      "markerToken": "u",
      "depth": 2,
      "order": 34,
      "sourceText": "“personal data breach” means any unauthorised processing of personal\ndata or accidental disclosure, acquisition, sharing, use, alteration, destruction or loss\nof access to personal data, that compromises the confidentiality, integrity or availability\nof personal data;",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:v",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(v)",
      "markerToken": "v",
      "depth": 2,
      "order": 35,
      "sourceText": "“prescribed” means prescribed by rules made under this Act;",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:w",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(w)",
      "markerToken": "w",
      "depth": 2,
      "order": 36,
      "sourceText": "“proceeding” means any action taken by the Board under the provisions of\nthis Act;",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:x",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(x)",
      "markerToken": "x",
      "depth": 2,
      "order": 37,
      "sourceText": "“processing” in relation to personal data, means a wholly or partly automated\noperation or set of operations performed on digital personal data, and includes\noperations such as collection, recording, organisation, structuring, storage, adaptation,\nretrieval, use, alignment or combination, indexing, sharing, disclosure by transmission,\ndissemination or otherwise making available, restriction, erasure or destruction;",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:y",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(y)",
      "markerToken": "y",
      "depth": 2,
      "order": 38,
      "sourceText": "“she” in relation to an individual includes the reference to such individual\nirrespective of gender;",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:z",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(z)",
      "markerToken": "z",
      "depth": 2,
      "order": 39,
      "sourceText": "“Significant Data Fiduciary” means any Data Fiduciary or class of Data\nFiduciaries as may be notified by the Central Government under section 10;",
      "crossReferences": [
        {
          "referenceKind": "section",
          "sourcePhrase": "section 10",
          "targetDocument": "doc:dpdp-act-2023",
          "target": "act:section:10",
          "resolutionStatus": "internal-resolved-root",
          "context": "“Significant Data Fiduciary” means any Data Fiduciary or class of Data Fiduciaries as may be notified by the Central Government under section 10;"
        }
      ],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:za",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(za)",
      "markerToken": "za",
      "depth": 2,
      "order": 40,
      "sourceText": "“specified purpose” means the purpose mentioned in the notice given by\nthe Data Fiduciary to the Data Principal in accordance with the provisions of this Act\nand the rules made thereunder; and",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:clause:zb",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:2",
      "rootProvision": "act:section:2",
      "provisionLevel": "clause",
      "marker": "(zb)",
      "markerToken": "zb",
      "depth": 2,
      "order": 41,
      "sourceText": "“State” means the State as defined under article 12 of the Constitution.",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "act:section:2:unstructured:1",
      "@type": "dpdp:TextBlock",
      "parent": "act:section:2",
      "sourceText": "In this Act, unless the context otherwise requires,—",
      "order": 0,
      "document": "doc:dpdp-act-2023"
    },
    {
      "@id": "act:section:3",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:chapter:i",
      "provisionLevel": "section",
      "sectionNumber": 3,
      "title": "Application of Act",
      "sourcePages": {
        "start": 3,
        "end": 4
      },
      "extractedSourceText": "3. Subject to the provisions of this Act, it shall—\n(a) apply to the processing of digital personal data within the territory of India\nwhere the personal data is collected––\n(i) in digital form; or\n(ii) in non-digital form and digitised subsequently;\n(b) also apply to processing of digital personal data outside the territory of\nIndia, if such processing is in connection with any activity related to offering of\ngoods or services to Data Principals within the territory of India;\n(c) not apply to—\n(i) personal data processed by an individual for any personal or domestic\npurpose; and\n(ii) personal data that is made or caused to be made publicly available\nby—\n(A) the Data Principal to whom such personal data relates; or\n(B) any other person who is under an obligation under any law for\nthe time being in force in India to make such personal data publicly\navailable.\nIllustration.\nX, an individual, while blogging her views, has publicly made available her personal\ndata on social media. In such case, the provisions of this Act shall not apply.\nCHAPTER II\nOBLIGATIONS OF DATA FIDUCIARY",
      "bodyText": "Subject to the provisions of this Act, it shall—\n(a) apply to the processing of digital personal data within the territory of India\nwhere the personal data is collected––\n(i) in digital form; or\n(ii) in non-digital form and digitised subsequently;\n(b) also apply to processing of digital personal data outside the territory of\nIndia, if such processing is in connection with any activity related to offering of\ngoods or services to Data Principals within the territory of India;\n(c) not apply to—\n(i) personal data processed by an individual for any personal or domestic\npurpose; and\n(ii) personal data that is made or caused to be made publicly available\nby—\n(A) the Data Principal to whom such personal data relates; or\n(B) any other person who is under an obligation under any law for\nthe time being in force in India to make such personal data publicly\navailable.\nIllustration.\nX, an individual, while blogging her views, has publicly made available her personal\ndata on social media. In such case, the provisions of this Act shall not apply.",
      "leadInText": "Subject to the provisions of this Act, it shall—",
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative",
      "crossReferences": []
    },
    {
