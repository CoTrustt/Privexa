    },
    {
      "@id": "act:section:42",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:chapter:ix",
      "provisionLevel": "section",
      "sectionNumber": 42,
      "title": "Power to amend Schedule",
      "sourcePages": {
        "start": 19,
        "end": 19
      },
      "extractedSourceText": "42. (1) The Central Government may, by notification, amend the Schedule, subject to\nthe restriction that no such notification shall have the effect of increasing any penalty\nspecified therein to more than twice of what was specified in it when this Act was originally\nenacted.\n(2) Any amendment notified under sub-section (1) shall have effect as if enacted in\nthis Act and shall come into force on the date of the notification.",
      "bodyText": "(1) The Central Government may, by notification, amend the Schedule, subject to\nthe restriction that no such notification shall have the effect of increasing any penalty\nspecified therein to more than twice of what was specified in it when this Act was originally\nenacted.\n(2) Any amendment notified under sub-section (1) shall have effect as if enacted in\nthis Act and shall come into force on the date of the notification.",
      "leadInText": "",
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative",
      "crossReferences": []
    },
    {
      "@id": "act:section:42:subsection:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:42",
      "rootProvision": "act:section:42",
      "provisionLevel": "subsection",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Central Government may, by notification, amend the Schedule, subject to\nthe restriction that no such notification shall have the effect of increasing any penalty\nspecified therein to more than twice of what was specified in it when this Act was originally\nenacted.",
      "crossReferences": []
    },
    {
      "@id": "act:section:42:subsection:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:42",
      "rootProvision": "act:section:42",
      "provisionLevel": "subsection",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "Any amendment notified under sub-section (1) shall have effect as if enacted in\nthis Act and shall come into force on the date of the notification.",
      "crossReferences": []
    },
    {
      "@id": "act:section:43",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:chapter:ix",
      "provisionLevel": "section",
      "sectionNumber": 43,
      "title": "Power to remove difficulties",
      "sourcePages": {
        "start": 19,
        "end": 19
      },
      "extractedSourceText": "43. (1) If any difficulty arises in giving effect to the provisions of this Act, the Central\nGovernment may, by order published in the Official Gazette, make such provisions not\ninconsistent with the provisions of this Act as may appear to it to be necessary or expedient\nfor removing the difficulty.\n(2) No order as referred to in sub-section (1) shall be made after the expiry of three\nyears from the date of commencement of this Act.\n(3) Every order made under this section shall be laid, as soon as may be after it is\nmade, before each House of Parliament.",
      "bodyText": "(1) If any difficulty arises in giving effect to the provisions of this Act, the Central\nGovernment may, by order published in the Official Gazette, make such provisions not\ninconsistent with the provisions of this Act as may appear to it to be necessary or expedient\nfor removing the difficulty.\n(2) No order as referred to in sub-section (1) shall be made after the expiry of three\nyears from the date of commencement of this Act.\n(3) Every order made under this section shall be laid, as soon as may be after it is\nmade, before each House of Parliament.",
      "leadInText": "",
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative",
      "crossReferences": []
    },
