    {
      "@id": "act:section:18:subsection:2:atomic:nonmodal-power:1",
      "@type": [
        "dpdp:Requirement",
        "dpdp:NormativeStatement"
      ],
      "sourceDocument": "doc:dpdp-act-2023",
      "sourceProvision": "act:section:18:subsection:2",
      "sourceText": "The Board shall be a body corporate by the name aforesaid, having perpetual\nsuccession and a common seal, with power, subject to the provisions of this Act, to acquire,\nhold and dispose of property, both movable and immovable, and to contract and shall, by\nthe said name, sue or be sued.",
      "propositionText": "The Board has power, subject to the Act, to acquire, hold and dispose of movable and immovable property and to contract.",
      "statementType": "power",
      "legalForce": "discretionary",
      "requirementGranularity": "atomic",
      "responsibleActor": "role:data-protection-board",
      "responsibleActors": [
        "role:data-protection-board"
      ],
      "actionText": "The Board has power, subject to the Act, to acquire, hold and dispose of movable and immovable property and to contract.",
      "conditions": [
        {
          "type": "subject_to",
          "text": "the Act, to acquire, hold and dispose of movable and immovable property and to contract"
        }
      ],
      "categories": [
        "board-governance"
      ],
      "normalizationMethod": "atomic-structural-final",
      "atomicOrigin": "nonmodal-power",
      "reviewStatus": "machine-normalized; source provision and uploaded Gazette PDF control",
      "normalizedRequirementText": "The Board has power, subject to the Act, to acquire, hold and dispose of movable and immovable property and to contract."
    },
    {
      "@id": "rule:20:atomic:nonmodal-power:1",
      "@type": [
        "dpdp:Requirement",
        "dpdp:NormativeStatement"
      ],
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:20",
      "sourceText": "The Board shall function as a digital office, without prejudice to its power to summon and enforce the attendance of any person and examine her on oath, may adopt techno-legal measures to conduct proceedings in a manner that does not require physical presence of any individual.",
      "propositionText": "The Board has power to summon and enforce attendance of any person and examine her on oath.",
      "statementType": "power",
      "legalForce": "discretionary",
      "requirementGranularity": "atomic",
      "responsibleActor": "role:data-protection-board",
      "responsibleActors": [
        "role:data-protection-board"
      ],
      "actionText": "The Board has power to summon and enforce attendance of any person and examine her on oath.",
      "categories": [
        "board-governance"
      ],
      "normalizationMethod": "atomic-structural-final",
      "atomicOrigin": "nonmodal-power",
      "reviewStatus": "machine-normalized; source provision and uploaded Gazette PDF control",
      "normalizedRequirementText": "The Board has power to summon and enforce attendance of any person and examine her on oath."
    },
    {
      "@id": "rule:22:subrule:3:clause:b:atomic:nonmodal-power:1",
      "@type": [
        "dpdp:Requirement",
        "dpdp:NormativeStatement"
      ],
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:22:subrule:3:clause:b",
      "sourceText": "shall function as a digital office which, without prejudice to its power to summon and enforce the\nattendance of any person and examine her on oath, may adopt techno -legal measures to conduct\nproceedings in a manner that does not require physical presence of any individual.",
      "propositionText": "The Appellate Tribunal has power to summon and enforce attendance of any person and examine her on oath.",
      "statementType": "power",
      "legalForce": "discretionary",
      "requirementGranularity": "atomic",
      "responsibleActor": "role:appellate-tribunal",
      "responsibleActors": [
        "role:appellate-tribunal"
      ],
      "actionText": "The Appellate Tribunal has power to summon and enforce attendance of any person and examine her on oath.",
      "categories": [
        "appeal"
      ],
      "normalizationMethod": "atomic-structural-final",
      "atomicOrigin": "nonmodal-power",
      "reviewStatus": "machine-normalized; source provision and uploaded Gazette PDF control",
      "normalizedRequirementText": "The Appellate Tribunal has power to summon and enforce attendance of any person and examine her on oath."
    },
    {
      "@id": "rule:22:subrule:2:atomic:nonmodal-power:1",
      "@type": [
        "dpdp:Requirement",
        "dpdp:NormativeStatement"
      ],
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:22:subrule:2",
      "sourceText": "An appeal filed with the Appellate Tribunal shall be accompanied by fee of like amount as is applicable\nin respect of an appeal filed under the Telecom Regulatory Authority of India Act, 1997 (24 of 1997),\nunless reduced or waived by the Chairperson of the Appellate Tribunal at her discretion, and the same shall\nbe payable digitally using the Unified Payments Interface or such other payment system authorised by the\nReserve Bank of India.",
      "propositionText": "The Chairperson of the Appellate Tribunal has discretion to reduce or waive the appeal fee.",
      "statementType": "power",
      "legalForce": "discretionary",
      "requirementGranularity": "atomic",
      "responsibleActor": "role:chairperson",
      "responsibleActors": [
        "role:chairperson"
      ],
      "actionText": "The Chairperson of the Appellate Tribunal has discretion to reduce or waive the appeal fee.",
      "categories": [
        "appeal",
        "board-governance"
      ],
      "normalizationMethod": "atomic-structural-final",
      "atomicOrigin": "nonmodal-power",
      "reviewStatus": "machine-normalized; source provision and uploaded Gazette PDF control",
      "normalizedRequirementText": "The Chairperson of the Appellate Tribunal has discretion to reduce or waive the appeal fee."
    },
    {
