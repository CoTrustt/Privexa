      "provisionLevel": "subsection",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "A person shall be disqualified for being appointed and continued as the\nChairperson or a Member, if she—",
      "crossReferences": []
    },
