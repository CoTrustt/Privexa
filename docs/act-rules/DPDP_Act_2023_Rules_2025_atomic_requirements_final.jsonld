      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Central Government may, by notification, restrict the transfer of personal\ndata by a Data Fiduciary for processing to such country or territory outside India as may be\nso notified.",
      "crossReferences": []
    },
    {
      "@id": "act:section:16:subsection:2",
