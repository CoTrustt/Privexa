    {
      "@id": "rule:18",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "provisionLevel": "rule",
      "ruleNumber": 18,
      "title": "Salary, allowances and other terms and conditions of service of Chairperson and other Members",
      "sourcePages": {
        "start": 7,
        "end": 7
      },
      "extractedSourceText": "18. Salary, allowances and other terms and conditions of service of Chairperson and other Members .\n—The Chairperson and every other Member shall receive such salary and allowances and shall have such\nother terms and conditions of service as are specified in Fifth Schedule.",
      "bodyText": "The Chairperson and every other Member shall receive such salary and allowances and shall have such\nother terms and conditions of service as are specified in Fifth Schedule.",
      "leadInText": "The Chairperson and every other Member shall receive such salary and allowances and shall have such other terms and conditions of service as are specified in Fifth Schedule.",
      "commencement": {
        "basis": "Rule 1",
        "effectiveDateDerived": "2025-11-13"
      },
      "implementsOrOperationalises": [
        "act:section:20"
      ],
