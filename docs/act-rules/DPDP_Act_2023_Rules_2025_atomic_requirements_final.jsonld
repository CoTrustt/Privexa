      "rootProvision": "act:section:10",
      "provisionLevel": "clause",
      "marker": "(b)",
      "markerToken": "b",
      "depth": 2,
      "order": 2,
      "sourceText": "risk to the rights of Data Principal;",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:1:clause:c",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:10:subsection:1",
      "rootProvision": "act:section:10",
      "provisionLevel": "clause",
      "marker": "(c)",
      "markerToken": "c",
      "depth": 2,
      "order": 3,
      "sourceText": "potential impact on the sovereignty and integrity of India;",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:1:clause:d",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:10:subsection:1",
      "rootProvision": "act:section:10",
      "provisionLevel": "clause",
      "marker": "(d)",
      "markerToken": "d",
      "depth": 2,
      "order": 4,
      "sourceText": "risk to electoral democracy;",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:1:clause:e",
      "@type": "dpdp:LegalProvision",
