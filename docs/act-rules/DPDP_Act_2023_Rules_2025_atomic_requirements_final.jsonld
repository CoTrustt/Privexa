        "dpdp:NormativeStatement"
      ],
      "sourceDocument": "doc:dpdp-rules-2025",
      "sourceProvision": "rule:13:subrule:3",
      "sourceText": "A Significant Data Fiduciary shall observe due diligence to verify that technical measures including algorithmic software adopted by it for hosting, display, uploading, modification, publishing, transmission, storage, updating or sharing of personal data processed by it are not likely to pose a risk to the rights of Data Principals.",
      "propositionText": "A Significant Data Fiduciary shall observe due diligence to verify that technical measures including algorithmic software adopted by it for hosting, display, uploading, modification, publishing, transmission, storage, updating or sharing of personal data processed by it are not likely to pose a risk to the rights of Data Principals.",
      "statementType": "obligation",
      "legalForce": "mandatory",
      "requirementGranularity": "atomic",
      "responsibleActor": "role:significant-data-fiduciary",
