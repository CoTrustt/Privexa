        }
      ]
    },
    {
      "@id": "rules:schedule:fifth:paragraph:8",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth",
      "itemNumber": 8,
      "title": "Other terms and conditions of service",
      "sourceText": "(1) The Chairperson and every other Member shall ensure\nabsence of conflict of interest in the performance of the functions of her office and shall not have any such\nfinancial or other interests as are likely to prejudicially affect the performance of the functions of such\noffice.\n(2) The provisions contained in Part IV to Part IX of the Central Civil Services (Classification, Control and\nAppeal) Rules, 1965, as applicable to an officer of the Central Government who is a member of a Central\nCivil Services, Group ‘A’, shall apply, mutatis mutandis, to the Chairperson and every other Member.\n(3) The Chairperson and every other Member shall not be entitled to any sitting fee for attending meetings\nof the Board.\n(4) The Chairperson and every other Member shall not be entitled to any sumptuary allowance.\n(5)Any matter relating to the conditions of service of the Chairperson or any other Member, in respect of\nwhich no express provision has been made in these rules, shall be referred to the Central Government for its\ndecision, and the decision of the Central Government on the same shall be final.",
      "extractedItemText": "Other terms and conditions of service . — (1) The Chairperson and every other Member shall ensure\nabsence of conflict of interest in the performance of the functions of her office and shall not have any such\nfinancial or other interests as are likely to prejudicially affect the performance of the functions of such\noffice.\n(2) The provisions contained in Part IV to Part IX of the Central Civil Services (Classification, Control and\nAppeal) Rules, 1965, as applicable to an officer of the Central Government who is a member of a Central\nCivil Services, Group ‘A’, shall apply, mutatis mutandis, to the Chairperson and every other Member.\n(3) The Chairperson and every other Member shall not be entitled to any sitting fee for attending meetings\nof the Board.\n(4) The Chairperson and every other Member shall not be entitled to any sumptuary allowance.\n(5)Any matter relating to the conditions of service of the Chairperson or any other Member, in respect of\nwhich no express provision has been made in these rules, shall be referred to the Central Government for its\ndecision, and the decision of the Central Government on the same shall be final.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:9",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth",
      "itemNumber": 9,
      "title": null,
      "sourceText": "In this Schedule, “pay matrix” shall mean the pay matrix specified in Annexure I to the Central\nGovernment’s Resolution published in the Official Gazette vide Notification no. 1-2/2016-IC, dated the 25th\nJuly, 2016.",
      "extractedItemText": "In this Schedule, “pay matrix” shall mean the pay matrix specified in Annexure I to the Central\nGovernment’s Resolution published in the Official Gazette vide Notification no. 1-2/2016-IC, dated the 25th\nJuly, 2016.",
      "crossReferences": [],
      "_has_children": true
    },
    {
      "@id": "rules:schedule:fifth:paragraph:1:subparagraph:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:1",
      "rootProvision": "rules:schedule:fifth:paragraph:1",
      "provisionLevel": "subparagraph",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Chairperson shall be entitled to receive a consolidated salary of rupees four lakh fifty\nthousand per month, without the facility of house and car.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:1:subparagraph:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:1",
      "rootProvision": "rules:schedule:fifth:paragraph:1",
      "provisionLevel": "subparagraph",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "Every Member other than the Chairperson shall be entitled to receive a consolidated salary of rupees\nfour lakh per month, without the facility of house and car.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:2:unstructured:1",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:2",
      "sourceText": "The Chairperson and every other Member shall be eligible to contribute to the",
      "order": 0
    },
    {
      "@id": "rules:schedule:fifth:paragraph:2:unstructured:2",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:2",
      "sourceText": "Provident Fund of the Board, and the manner and terms and conditions applicable in this regard shall,",
      "order": 1
    },
    {
      "@id": "rules:schedule:fifth:paragraph:2:unstructured:3",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:2",
      "sourceText": "mutatis mutandis, be the same as those applicable to other officers and employees of the Board for their",
      "order": 2
    },
    {
      "@id": "rules:schedule:fifth:paragraph:2:unstructured:4",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:2",
      "sourceText": "Provident Fund.",
      "order": 3
    },
    {
      "@id": "rules:schedule:fifth:paragraph:3:unstructured:1",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:3",
      "sourceText": "The Chairperson and every other Member shall not be entitled to payment of",
      "order": 0
    },
    {
      "@id": "rules:schedule:fifth:paragraph:3:unstructured:2",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:3",
      "sourceText": "pension or gratuity for service rendered in the Board.",
      "order": 1
    },
    {
      "@id": "rules:schedule:fifth:paragraph:4:subparagraph:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:4",
      "rootProvision": "rules:schedule:fifth:paragraph:4",
      "provisionLevel": "subparagraph",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Chairperson and every other Member, while on transfer to join the\nBoard, or on the expiry of her term with the Board for proceeding to her home town with family (including\nin respect of journey undertaken by her and her family), or on tour within India, shall be entitled to journey\nallowance, daily allowance and reimbursement of expense on transportation of personal effects at such\nscales and rates as are applicable to an officer of the Central Government in the following level of the pay\nmatrix, namely:—",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:4:subparagraph:1:clause:a",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:4:subparagraph:1",
      "rootProvision": "rules:schedule:fifth:paragraph:4",
      "provisionLevel": "clause",
      "marker": "(a)",
      "markerToken": "a",
      "depth": 2,
      "order": 1,
      "sourceText": "level 17, in the case of the Chairperson; and",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:4:subparagraph:1:clause:b",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:4:subparagraph:1",
      "rootProvision": "rules:schedule:fifth:paragraph:4",
      "provisionLevel": "clause",
      "marker": "(b)",
      "markerToken": "b",
      "depth": 2,
      "order": 2,
      "sourceText": "level 15, in the case of every other Member.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:4:subparagraph:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:4",
      "rootProvision": "rules:schedule:fifth:paragraph:4",
      "provisionLevel": "subparagraph",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 3,
      "sourceText": "The Chairperson and every other Member may undertake tour outside India only in accordance with\nguidelines or instructions issued by the Central Government, and in respect of such tour, she shall be\nentitled to draw the same allowances as an officer of the Central Government, in the following level of the\npay matrix, is entitled to draw, namely: —",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:4:subparagraph:2:clause:a",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:4:subparagraph:2",
      "rootProvision": "rules:schedule:fifth:paragraph:4",
      "provisionLevel": "clause",
      "marker": "(a)",
      "markerToken": "a",
      "depth": 2,
      "order": 4,
      "sourceText": "level 17, in the case of the Chairperson; and",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:4:subparagraph:2:clause:b",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:4:subparagraph:2",
      "rootProvision": "rules:schedule:fifth:paragraph:4",
      "provisionLevel": "clause",
      "marker": "(b)",
      "markerToken": "b",
      "depth": 2,
      "order": 5,
      "sourceText": "level 15, in the case of every other Member.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:5:subparagraph:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:5",
      "rootProvision": "rules:schedule:fifth:paragraph:5",
      "provisionLevel": "subparagraph",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Chairperson and every other Member shall be entitled to such medical\nassistance as may be admissible to them under any group health insurance scheme of the Board for officers\nand employees of the Board and their eligible dependants.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:5:subparagraph:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:5",
      "rootProvision": "rules:schedule:fifth:paragraph:5",
      "provisionLevel": "subparagraph",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "If the Chairperson or other Member has retired from Government service, or from the service of a\npublic sector entity or a body corporate established by a Central Act, Provincial Act or State Act, and there\nare a separate set of rules for the grant of medical assistance for such service, she may, in lieu of medical\nassistance under sub-paragraph (1), opt to be governed by such rules.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:6:subparagraph:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:6",
      "rootProvision": "rules:schedule:fifth:paragraph:6",
      "provisionLevel": "subparagraph",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The authority competent to sanction leave shall be the Central Government in respect of\nthe Chairperson, and the Chairperson in respect of any other Member.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:6:subparagraph:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:6",
      "rootProvision": "rules:schedule:fifth:paragraph:6",
      "provisionLevel": "subparagraph",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "The Chairperson and every other Member may avail of such kinds of leave as are admissible to a\nGovernment servant under sub-clause (i) of clause (a) and clause (b) of sub-rule (1) of rule 26, rules 27, 29,\n30 and 40 to 43 -C of the Central Civil Services (Leave) Rules, 1972 (hereinafter referred to as “Leave\nRules”).",
      "crossReferences": [
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 26",
          "targetDocument": "ext:ccs-leave-rules-1972",
          "resolutionStatus": "external-or-unresolved",
          "context": "The Chairperson and every other Member may avail of such kinds of leave as are admissible to a Government servant under sub-clause (i) of clause (a) and clause (b) of sub-rule (1) of rule 26, rules 27, 29, 30 and 40 to 43 -C of the Central Civil Services (Leave) Rules, 1972 (hereinafter referred to as “Leave Rules”)."
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rules 27",
          "targetDocument": "ext:ccs-leave-rules-1972",
          "resolutionStatus": "external-or-unresolved",
          "context": "The Chairperson and every other Member may avail of such kinds of leave as are admissible to a Government servant under sub-clause (i) of clause (a) and clause (b) of sub-rule (1) of rule 26, rules 27, 29, 30 and 40 to 43 -C of the Central Civil Services (Leave) Rules, 1972 (hereinafter referred to as “Leave Rules”)."
        }
      ]
    },
    {
      "@id": "rules:schedule:fifth:paragraph:6:subparagraph:3",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:6",
      "rootProvision": "rules:schedule:fifth:paragraph:6",
      "provisionLevel": "subparagraph",
      "marker": "(3)",
      "markerToken": "3",
      "depth": 1,
      "order": 2,
      "sourceText": "Leave shall be subject to the conditions applicable to a Government servant under rules 7 to 11 and 22\nto 25 of the Leave Rules, and the Central Government may, if satisfied that the operation of any of the said\nrules causes undue hardship in a particular case, by order relax the requirements of that rule to such extent\nand subject to such exceptions and conditions as it may consider necessary for dealing with the case in a\njust and equitable manner.",
      "crossReferences": [
        {
          "referenceKind": "rule",
          "sourcePhrase": "rules 7",
          "targetDocument": "ext:ccs-leave-rules-1972",
          "resolutionStatus": "external-or-unresolved",
          "context": "Leave shall be subject to the conditions applicable to a Government servant under rules 7 to 11 and 22 to 25 of the Leave Rules, and the Central Government may, if satisfied that the operation of any of the said rules causes undue hardship in a particular case, by order relax the requirements of that rule to such extent and subject to such exceptions and conditions as it may consider necessary for dealing with the case in a just and equitable manner."
        }
      ]
    },
    {
      "@id": "rules:schedule:fifth:paragraph:6:subparagraph:4",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:6",
      "rootProvision": "rules:schedule:fifth:paragraph:6",
      "provisionLevel": "subparagraph",
      "marker": "(4)",
      "markerToken": "4",
      "depth": 1,
      "order": 3,
      "sourceText": "The Chairperson and every other Member shall be entitled to casual leave to such extent as is\nadmissible to a Government servant under instructions issued by the Central Government.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:6:subparagraph:5",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:6",
      "rootProvision": "rules:schedule:fifth:paragraph:6",
      "provisionLevel": "subparagraph",
      "marker": "(5)",
      "markerToken": "5",
      "depth": 1,
      "order": 4,
      "sourceText": "The Chairperson and every other Member shall be entitled to encashment of earned leave standing to\nher credit, subject to such conditions and in like manner as are applicable to a Government servant under\nrule 38-A, sub-rules (1) and (2) and sub-clauses (i) and (ii) of clause (a) of sub-rule (6) of rule 39, rule 39-A\nand rule 39 -C of the Leave Rules, subject to the maximum extent of encashment under any of the said\nrules, other than rule 38-A, being fifty per cent. of the earned leave standing to her credit.",
      "crossReferences": [
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 38-A",
          "targetDocument": "ext:ccs-leave-rules-1972",
          "resolutionStatus": "external-or-unresolved",
          "context": "The Chairperson and every other Member shall be entitled to encashment of earned leave standing to her credit, subject to such conditions and in like manner as are applicable to a Government servant under rule 38-A, sub-rules (1) and (2) and sub-clauses (i) and (ii) of clause (a) of sub-rule (6) of rule 39, rule 39-A and rule 39 -C of the Leave Rules, subject to the maximum extent of encashment under any of the said rules, other than rule 38-A, being fifty per cent."
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 39",
          "targetDocument": "ext:ccs-leave-rules-1972",
          "resolutionStatus": "external-or-unresolved",
          "context": "The Chairperson and every other Member shall be entitled to encashment of earned leave standing to her credit, subject to such conditions and in like manner as are applicable to a Government servant under rule 38-A, sub-rules (1) and (2) and sub-clauses (i) and (ii) of clause (a) of sub-rule (6) of rule 39, rule 39-A and rule 39 -C of the Leave Rules, subject to the maximum extent of encashment under any of the said rules, other than rule 38-A, being fifty per cent."
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 39-A",
          "targetDocument": "ext:ccs-leave-rules-1972",
          "resolutionStatus": "external-or-unresolved",
          "context": "The Chairperson and every other Member shall be entitled to encashment of earned leave standing to her credit, subject to such conditions and in like manner as are applicable to a Government servant under rule 38-A, sub-rules (1) and (2) and sub-clauses (i) and (ii) of clause (a) of sub-rule (6) of rule 39, rule 39-A and rule 39 -C of the Leave Rules, subject to the maximum extent of encashment under any of the said rules, other than rule 38-A, being fifty per cent."
        }
      ]
    },
    {
      "@id": "rules:schedule:fifth:paragraph:7:subparagraph:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:7",
      "rootProvision": "rules:schedule:fifth:paragraph:7",
      "provisionLevel": "subparagraph",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "Leave travel concession shall be admissible to the Chairperson and every\nother Member in accordance with the provisions applicable to persons appointed to civil services and posts\nin connection with the affairs of the Union of India under rule 3, clauses (a) and (d) of rule 4, rules 5 to 15\nand rule 17 of the Central Civil Services (Leave Travel Concession) Rules, 1988, and the entitlement for\nsuch concession shall be the same as is applicable to officers of the Central Government in level 17 of the\npay matrix in the case of the Chairperson, and to officers of the Central Government in level 15 of the pay\nmatrix in the case of a Member.",
      "crossReferences": [
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 3",
          "targetDocument": "ext:ccs-ltc-rules-1988",
          "resolutionStatus": "external-or-unresolved",
          "context": "Leave travel concession shall be admissible to the Chairperson and every other Member in accordance with the provisions applicable to persons appointed to civil services and posts in connection with the affairs of the Union of India under rule 3, clauses (a) and (d) of rule 4, rules 5 to 15 and rule 17 of the Central Civil Services (Leave Travel Concession) Rules, 1988, and the entitlement for such concession shall be the same as is applicable to officers of the Central Government in level 17 of"
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 4",
          "targetDocument": "ext:ccs-ltc-rules-1988",
          "resolutionStatus": "external-or-unresolved",
          "context": "Leave travel concession shall be admissible to the Chairperson and every other Member in accordance with the provisions applicable to persons appointed to civil services and posts in connection with the affairs of the Union of India under rule 3, clauses (a) and (d) of rule 4, rules 5 to 15 and rule 17 of the Central Civil Services (Leave Travel Concession) Rules, 1988, and the entitlement for such concession shall be the same as is applicable to officers of the Central Government in level 17 of"
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rules 5",
          "targetDocument": "ext:ccs-ltc-rules-1988",
          "resolutionStatus": "external-or-unresolved",
          "context": "Leave travel concession shall be admissible to the Chairperson and every other Member in accordance with the provisions applicable to persons appointed to civil services and posts in connection with the affairs of the Union of India under rule 3, clauses (a) and (d) of rule 4, rules 5 to 15 and rule 17 of the Central Civil Services (Leave Travel Concession) Rules, 1988, and the entitlement for such concession shall be the same as is applicable to officers of the Central Government in level 17 of"
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 17",
          "targetDocument": "ext:ccs-ltc-rules-1988",
          "resolutionStatus": "external-or-unresolved",
          "context": "Leave travel concession shall be admissible to the Chairperson and every other Member in accordance with the provisions applicable to persons appointed to civil services and posts in connection with the affairs of the Union of India under rule 3, clauses (a) and (d) of rule 4, rules 5 to 15 and rule 17 of the Central Civil Services (Leave Travel Concession) Rules, 1988, and the entitlement for such concession shall be the same as is applicable to officers of the Central Government in level 17 of"
        }
      ]
    },
    {
      "@id": "rules:schedule:fifth:paragraph:7:subparagraph:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:7",
      "rootProvision": "rules:schedule:fifth:paragraph:7",
      "provisionLevel": "subparagraph",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "The Chairperson and every other Member shall be eligible to avail of either leave travel concession to\nhome town or leave travel concession to any place in India in any period of two years from the date of\nassumption of their office as a Member.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:8:subparagraph:1",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:8",
      "rootProvision": "rules:schedule:fifth:paragraph:8",
      "provisionLevel": "subparagraph",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Chairperson and every other Member shall ensure\nabsence of conflict of interest in the performance of the functions of her office and shall not have any such\nfinancial or other interests as are likely to prejudicially affect the performance of the functions of such\noffice.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:8:subparagraph:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:8",
      "rootProvision": "rules:schedule:fifth:paragraph:8",
      "provisionLevel": "subparagraph",
      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "The provisions contained in Part IV to Part IX of the Central Civil Services (Classification, Control and\nAppeal) Rules, 1965, as applicable to an officer of the Central Government who is a member of a Central\nCivil Services, Group ‘A’, shall apply, mutatis mutandis, to the Chairperson and every other Member.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:8:subparagraph:3",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:8",
      "rootProvision": "rules:schedule:fifth:paragraph:8",
      "provisionLevel": "subparagraph",
      "marker": "(3)",
      "markerToken": "3",
      "depth": 1,
      "order": 2,
      "sourceText": "The Chairperson and every other Member shall not be entitled to any sitting fee for attending meetings\nof the Board.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:8:subparagraph:4",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:8",
      "rootProvision": "rules:schedule:fifth:paragraph:8",
      "provisionLevel": "subparagraph",
      "marker": "(4)",
      "markerToken": "4",
      "depth": 1,
      "order": 3,
      "sourceText": "The Chairperson and every other Member shall not be entitled to any sumptuary allowance.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:8:subparagraph:5",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:fifth:paragraph:8",
      "rootProvision": "rules:schedule:fifth:paragraph:8",
      "provisionLevel": "subparagraph",
      "marker": "(5)",
      "markerToken": "5",
      "depth": 1,
      "order": 4,
      "sourceText": "Any matter relating to the conditions of service of the Chairperson or any other Member, in respect of\nwhich no express provision has been made in these rules, shall be referred to the Central Government for its\ndecision, and the decision of the Central Government on the same shall be final.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:fifth:paragraph:9:unstructured:1",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:9",
      "sourceText": "In this Schedule, “pay matrix” shall mean the pay matrix specified in Annexure I to the Central",
      "order": 0
    },
    {
      "@id": "rules:schedule:fifth:paragraph:9:unstructured:2",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:9",
      "sourceText": "Government’s Resolution published in the Official Gazette vide Notification no. 1-2/2016-IC, dated the 25th",
      "order": 1
    },
    {
      "@id": "rules:schedule:fifth:paragraph:9:unstructured:3",
      "@type": "dpdp:TextBlock",
      "parent": "rules:schedule:fifth:paragraph:9",
      "sourceText": "July, 2016.",
      "order": 2
    },
    {
      "@id": "rules:schedule:sixth:paragraph:1",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 1,
      "title": "Classes of officials",
      "sourceText": "(1) The Board may, in accordance with the Fundamental Rules and applicable\nguidelines issued by the Ministry of Personnel, Public Grievances and Pensions, Department of Personnel\nand Training, appoint officers and employees on deputation from the Central Government, a State\nGovernment, an autonomous body under the overall control of the Central Government or a State\nGovernment, a statutory body, or a public sector enterprise, for a period not exceeding five years.\n(2) The Board may also receive or take on deputation any officer or other employee from the National\nInstitute for Smart Government, for a period not exceeding five years, with salary and allowances guided\nby market standards and on such other terms and conditions as the Board may decide.",
      "extractedItemText": "Classes of officials . — (1) The Board may, in accordance with the Fundamental Rules and applicable\nguidelines issued by the Ministry of Personnel, Public Grievances and Pensions, Department of Personnel\nand Training, appoint officers and employees on deputation from the Central Government, a State\nGovernment, an autonomous body under the overall control of the Central Government or a State\nGovernment, a statutory body, or a public sector enterprise, for a period not exceeding five years.\n(2) The Board may also receive or take on deputation any officer or other employee from the National\nInstitute for Smart Government, for a period not exceeding five years, with salary and allowances guided\nby market standards and on such other terms and conditions as the Board may decide.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:sixth:paragraph:2",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 2,
      "title": "Gratuity",
      "sourceText": "The officers and employees shall be entitled to payment of such gratuity as may be\nadmissible under the Payment of Gratuity Act, 1972 (39 of 1972).",
      "extractedItemText": "Gratuity . —The officers and employees shall be entitled to payment of such gratuity as may be\nadmissible under the Payment of Gratuity Act, 1972 (39 of 1972).",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:sixth:paragraph:3",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 3,
      "title": "Travelling allowance",
      "sourceText": "The travelling allowance payable to the officers and employees shall, mutatis\nmutandis, be the same as those applicable to the officers and employees of the Central Government.",
      "extractedItemText": "Travelling allowance. —The travelling allowance payable to the officers and employees shall, mutatis\nmutandis, be the same as those applicable to the officers and employees of the Central Government.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:sixth:paragraph:4",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 4,
      "title": "Medical assistance",
      "sourceText": "The officers and employees shall be entitled to such medical assistance as may be\nadmissible to them and their eligible dependants under any group health insurance scheme of the Board,\nmade with the previous approval of the Central Government.",
      "extractedItemText": "Medical assistance. —The officers and employees shall be entitled to such medical assistance as may be\nadmissible to them and their eligible dependants under any group health insurance scheme of the Board,\nmade with the previous approval of the Central Government.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:sixth:paragraph:5",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 5,
      "title": "Leave",
      "sourceText": "(1) The officers and employees may avail of such kinds of leaves as are admissible to a\nGovernment servant under the Central Civil Services (Leave) Rules, 1972, subject to the conditions\napplicable under the said rules, and shall be eligible for encashment of earned leave as provided therein.\n(2) The officers and employees shall be entitled to casual leave to such extent as is admissible to a\nGovernment servant under instructions issued by the Central Government.",
      "extractedItemText": "Leave . — (1) The officers and employees may avail of such kinds of leaves as are admissible to a\nGovernment servant under the Central Civil Services (Leave) Rules, 1972, subject to the conditions\napplicable under the said rules, and shall be eligible for encashment of earned leave as provided therein.\n(2) The officers and employees shall be entitled to casual leave to such extent as is admissible to a\nGovernment servant under instructions issued by the Central Government.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:sixth:paragraph:6",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 6,
      "title": "Leave travel concession",
      "sourceText": "Leave travel concession shall be admissible to the officers and employees\nappointed under clause (1) of paragraph 1, in accordance with the provisions applicable to persons\nappointed to civil services and posts in connection with the affairs of the Union of India under the Central\nCivil Services (Leave Travel Concession) Rules, 1988.",
      "extractedItemText": "Leave travel concession . — Leave travel concession shall be admissible to the officers and employees\nappointed under clause (1) of paragraph 1, in accordance with the provisions applicable to persons\nappointed to civil services and posts in connection with the affairs of the Union of India under the Central\nCivil Services (Leave Travel Concession) Rules, 1988.",
      "crossReferences": []
    },
    {
      "@id": "rules:schedule:sixth:paragraph:7",
      "@type": "dpdp:ScheduleItem",
      "document": "doc:dpdp-rules-2025",
      "parent": "rules:schedule:sixth",
      "itemNumber": 7,
      "title": "Other terms and conditions of service",
      "sourceText": "(1) The provisions of the Civil Service (Conduct) Rules,\n1964 shall apply to the officers and employees in like manner as applicable to a person appointed to a civil\nservice or post in connection with the affairs of the Union of India under the said rules.\n(2) The provisions contained in Part IV to Part IX of the Central Civil Services (Classification, Control and\nAppeal) Rules, 1965 shall apply, mutatis mutandis, to the officers and employees appointed under clause\n(1) of paragraph 1, in like manner as applicable to a Government servant under the said rules.\n(3)Any matter relating to the terms and conditions of service of the officers and employees appointed under\nclause (1) of paragraph 1, in respect of which no express provision has been made in these rules, shall be\nreferred to the Central Government for its decision, and the decision of the Central Government on the\nsame shall be final.",
      "extractedItemText": "Other terms and conditions of service . — (1) The provisions of the Civil Service (Conduct) Rules,\n1964 shall apply to the officers and employees in like manner as applicable to a person appointed to a civil\nservice or post in connection with the affairs of the Union of India under the said rules.\n(2) The provisions contained in Part IV to Part IX of the Central Civil Services (Classification, Control and\nAppeal) Rules, 1965 shall apply, mutatis mutandis, to the officers and employees appointed under clause\n(1) of paragraph 1, in like manner as applicable to a Government servant under the said rules.\n(3)Any matter relating to the terms and conditions of service of the officers and employees appointed under\nclause (1) of paragraph 1, in respect of which no express provision has been made in these rules, shall be\nreferred to the Central Government for its decision, and the decision of the Central Government on the\nsame shall be final.",
      "crossReferences": []
    },
