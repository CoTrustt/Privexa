      ],
      "modalPhrase": "shall",
      "sourceModalIndex": 1,
      "normalizedRequirementText": "significant data fiduciary shall , once in every period of twelve months from the date on which it is notified as such or is included in the class of Data Fiduciaries notified as such, undertake a Data Protection Impact Assessment and an audit to ensure effective observance of the provisions of this Act and the rules made thereunder."
    },
    {
      "@id": "rule:13:subrule:2:atomic:explicit:1",
