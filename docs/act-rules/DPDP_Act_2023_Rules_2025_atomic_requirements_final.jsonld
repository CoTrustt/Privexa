      "marker": "(i)",
      "markerToken": "i",
      "depth": 3,
      "order": 6,
      "sourceText": "personal data processed by an individual for any personal or domestic\npurpose; and",
      "crossReferences": []
    },
    {
      "@id": "act:section:3:clause:c:subclause:ii",
      "@type": "dpdp:LegalProvision",
