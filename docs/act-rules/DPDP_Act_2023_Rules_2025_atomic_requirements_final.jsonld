  "@id": "doc:dpdp-corpus-act-2023-rules-2025-atomic-final",
  "@type": "dpdp:RegulatoryCorpus",
  "title": "India DPDP Act 2023 + DPDP Rules 2025 — Atomic Linked Requirements Atomic Requirements Corpus — Final Rebuild",
  "jurisdiction": "India",
  "sourceBasis": [
    {
      "document": "doc:dpdp-act-2023",
      "role": "authoritative-source-as-uploaded",
      "sha256": "4deb23981d3010c8225a2ff6149e7243dc2268455b299e283afebdd7b72a7d15"
    },
    {
      "document": "doc:dpdp-rules-2025",
      "role": "authoritative-source-as-uploaded",
      "sha256": "63bc7ca508ae4ebbbbf8731d336914d94ee6067e918b719d019193371fcc0763"
    }
  ],
  "modelNotes": {
    "sourceTextPolicy": "Uploaded Gazette PDFs remain authoritative. Extracted source text and proposition text are machine representations.",
    "atomicityPolicy": "Every emitted dpdp:Requirement is atomic: one explicit operative proposition, one inherited enumerated normative element, or one specialized normative Schedule row. Composite/umbrella Requirement records are not emitted.",
    "definitionPolicy": "Definitions and all descendants of definition provisions are excluded from Requirement generation.",
    "schedulePolicy": "Third/Fourth/Seventh Schedule rows and the Act penalty Schedule are also exposed as dpdp:Requirement / dpdp:NormativeStatement nodes so normative Schedule content is queryable through a single type.",
    "actorPolicy": "Responsible actor is based on the grammatical/governing subject with curated overrides for known legal list and embedded-power constructions; exemptions generally have no obligated actor.",
    "validationPolicy": "Explicit operative modal occurrences are accounted for as atomic requirements, list lead-ins represented through child requirements, or exclusions with a stated reason."
  },
