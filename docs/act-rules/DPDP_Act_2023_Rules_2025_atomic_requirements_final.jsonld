      "crossReferences": []
    },
    {
      "@id": "rule:14:subrule:3",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rule:14",
      "rootProvision": "rule:14",
      "provisionLevel": "subrule",
      "marker": "(3)",
      "markerToken": "3",
      "depth": 1,
      "order": 4,
      "sourceText": "Every Data Fiduciary and Consent Manager shall prominently publish on its website or app, or both, as\nthe case may be, within a reasonable period not exceeding ninety days under its grievance redressal system\nfor responding to the grievances of Data Principals and shall, for ensuring the effectiveness of the system in\nresponding within such period, implement appropriate technical and organisational measures.",
      "crossReferences": []
    },
    {
      "@id": "rule:14:subrule:4",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rule:14",
      "rootProvision": "rule:14",
      "provisionLevel": "subrule",
      "marker": "(4)",
      "markerToken": "4",
      "depth": 1,
      "order": 5,
      "sourceText": "To exercise the rights of the Data Principal under the Act, she may, in accordance with the terms of\nservice of the Data Fiduciary and such law as may be applicable, nominate one or more individuals, using\nthe means and furnishing the particulars required by such Data Fiduciary for the exercise of such right.",
      "crossReferences": []
    },
    {
      "@id": "rule:14:subrule:5",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "parent": "rule:14",
      "rootProvision": "rule:14",
      "provisionLevel": "subrule",
      "marker": "(5)",
      "markerToken": "5",
      "depth": 1,
      "order": 6,
      "sourceText": "In this rule, the expression “identifier” shall mean any sequence of characters issued by the Data\nFiduciary to identify the Data Principal and includes a customer identification file number, customer\nacquisition form number, application reference number, enrolment ID, email address, mobile number or\nlicence number that enables such identification.",
      "crossReferences": [],
      "_has_children": false
    },
    {
      "@id": "rule:15",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "provisionLevel": "rule",
      "ruleNumber": 15,
      "title": "Transfer of personal data outside the territory of India",
      "sourcePages": {
        "start": 7,
        "end": 7
      },
      "extractedSourceText": "15. Transfer of personal data outside the territory of India. — Any personal data processed by a Data\nFiduciary under the Act may be transferred outside the territory of India subject to the restriction that the\nData Fiduciary shall meet such requirements as the Central Government may, by general or special order,\nspecify in respect of making such personal data available to any foreign State, or to any person or entity\nunder the control of or any agency of such a State.",
      "bodyText": "Any personal data processed by a Data\nFiduciary under the Act may be transferred outside the territory of India subject to the restriction that the\nData Fiduciary shall meet such requirements as the Central Government may, by general or special order,\nspecify in respect of making such personal data available to any foreign State, or to any person or entity\nunder the control of or any agency of such a State.",
      "leadInText": "Any personal data processed by a Data Fiduciary under the Act may be transferred outside the territory of India subject to the restriction that the Data Fiduciary shall meet such requirements as the Central Government may, by general or special order, specify in respect of making such personal data available to any foreign State, or to any person or entity under the control of or any agency of such a State.",
      "commencement": {
        "basis": "Rule 1",
        "effectiveDateDerived": "2027-05-13"
      },
      "implementsOrOperationalises": [
        "act:section:16"
      ],
      "delegationBasis": [
        "act:section:40:subsection:1"
      ],
      "crossReferences": [],
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative"
    },
    {
