      "rootProvision": "act:section:19",
      "provisionLevel": "subsection",
      "marker": "(1)",
      "markerToken": "1",
      "depth": 1,
      "order": 0,
      "sourceText": "The Board shall consist of a Chairperson and such number of other Members\nas the Central Government may notify.",
      "crossReferences": []
    },
    {
      "@id": "act:section:19:subsection:2",
      "@type": "dpdp:LegalProvision",
