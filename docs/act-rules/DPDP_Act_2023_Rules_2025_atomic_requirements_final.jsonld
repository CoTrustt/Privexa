      "@type": "dpdp:TextBlock",
      "parent": "rule:15",
      "sourceText": "Any personal data processed by a Data",
      "order": 0,
      "document": "doc:dpdp-rules-2025"
    },
    {
      "@id": "rule:15:unstructured:2",
      "@type": "dpdp:TextBlock",
      "parent": "rule:15",
      "sourceText": "Fiduciary under the Act may be transferred outside the territory of India subject to the restriction that the",
      "order": 1,
      "document": "doc:dpdp-rules-2025"
    },
    {
      "@id": "rule:15:unstructured:3",
      "@type": "dpdp:TextBlock",
      "parent": "rule:15",
      "sourceText": "Data Fiduciary shall meet such requirements as the Central Government may, by general or special order,",
      "order": 2,
      "document": "doc:dpdp-rules-2025"
    },
    {
      "@id": "rule:15:unstructured:4",
      "@type": "dpdp:TextBlock",
      "parent": "rule:15",
      "sourceText": "specify in respect of making such personal data available to any foreign State, or to any person or entity",
      "order": 3,
      "document": "doc:dpdp-rules-2025"
    },
    {
      "@id": "rule:15:unstructured:5",
      "@type": "dpdp:TextBlock",
      "parent": "rule:15",
      "sourceText": "under the control of or any agency of such a State.",
      "order": 4,
      "document": "doc:dpdp-rules-2025"
    },
    {
      "@id": "rule:16",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "provisionLevel": "rule",
      "ruleNumber": 16,
      "title": "Exemption from Act for research, archiving or statistical purposes",
      "sourcePages": {
        "start": 7,
        "end": 7
      },
      "extractedSourceText": "16. Exemption from Act for research, archiving or statistical purposes . —The provisions of the Act\nshall not apply to the processing of personal data necessary for research, archiving or statistical purposes if\nit is carried on in accordance with the standards specified in Second Schedule.",
      "bodyText": "The provisions of the Act\nshall not apply to the processing of personal data necessary for research, archiving or statistical purposes if\nit is carried on in accordance with the standards specified in Second Schedule.",
      "leadInText": "The provisions of the Act shall not apply to the processing of personal data necessary for research, archiving or statistical purposes if it is carried on in accordance with the standards specified in Second Schedule.",
      "commencement": {
        "basis": "Rule 1",
        "effectiveDateDerived": "2027-05-13"
      },
      "implementsOrOperationalises": [
