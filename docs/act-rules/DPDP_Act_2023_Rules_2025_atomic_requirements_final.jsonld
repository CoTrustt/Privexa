      "order": 8,
      "document": "doc:dpdp-act-2023"
    },
    {
      "@id": "act:section:7:interpretation:1",
      "@type": "dpdp:Interpretation",
      "parent": "act:section:7",
      "sourceText": "Explanation.—For the purposes of this clause, the expression “disaster” shall\nhave the same meaning as assigned to it in clause (d) of section 2 of the Disaster\nManagement Act, 2005; or",
