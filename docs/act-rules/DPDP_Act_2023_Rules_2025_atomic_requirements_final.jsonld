      "marker": "(b)",
      "markerToken": "b",
      "depth": 2,
      "order": 2,
      "sourceText": "has been convicted of an offence, which in the opinion of the Central\nGovernment, involves moral turpitude;",
      "crossReferences": []
    },
    {
      "@id": "act:section:21:subsection:1:clause:c",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:21:subsection:1",
      "rootProvision": "act:section:21",
      "provisionLevel": "clause",
      "marker": "(c)",
      "markerToken": "c",
      "depth": 2,
      "order": 3,
      "sourceText": "has become physically or mentally incapable of acting as a Member;",
      "crossReferences": []
    },
    {
      "@id": "act:section:21:subsection:1:clause:d",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:21:subsection:1",
      "rootProvision": "act:section:21",
