      "marker": "(2)",
      "markerToken": "2",
      "depth": 1,
      "order": 1,
      "sourceText": "The Chairperson and other Members shall be appointed by the Central Government\nin such manner as may be prescribed.",
      "crossReferences": []
    },
    {
      "@id": "act:section:19:subsection:3",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:19",
      "rootProvision": "act:section:19",
