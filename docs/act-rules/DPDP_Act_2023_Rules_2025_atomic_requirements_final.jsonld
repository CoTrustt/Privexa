      "marker": "(ii)",
      "markerToken": "ii",
      "depth": 3,
      "order": 10,
      "sourceText": "be based in India;",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:2:clause:a:subclause:iii",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:section:10:subsection:2:clause:a",
      "rootProvision": "act:section:10",
