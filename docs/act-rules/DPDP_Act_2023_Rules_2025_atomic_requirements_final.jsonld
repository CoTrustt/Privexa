      "rootProvision": "act:section:10",
      "provisionLevel": "clause",
      "marker": "(a)",
      "markerToken": "a",
      "depth": 2,
      "order": 1,
      "sourceText": "the volume and sensitivity of personal data processed;",
      "crossReferences": []
    },
    {
