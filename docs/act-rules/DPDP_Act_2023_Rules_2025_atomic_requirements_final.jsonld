      "parent": "act:section:41",
      "sourceText": "following the session or the successive sessions aforesaid, both Houses agree in making",
      "order": 4,
      "document": "doc:dpdp-act-2023"
    },
    {
      "@id": "act:section:41:unstructured:6",
