      "markerToken": "4",
      "depth": 1,
      "order": 5,
      "sourceText": "A Data Fiduciary shall implement appropriate technical and organisational measures\nto ensure effective observance of the provisions of this Act and the rules made thereunder.",
      "crossReferences": []
    },
    {
