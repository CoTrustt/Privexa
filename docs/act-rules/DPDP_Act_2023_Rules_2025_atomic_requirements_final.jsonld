      "crossReferences": []
    },
    {
      "@id": "act:section:3:unstructured:1",
      "@type": "dpdp:TextBlock",
      "parent": "act:section:3",
      "sourceText": "Subject to the provisions of this Act, it shall—",
      "order": 0,
      "document": "doc:dpdp-act-2023"
    },
    {
      "@id": "act:section:3:illustration:1",
