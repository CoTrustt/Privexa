      "crossReferences": []
    },
    {
      "@id": "act:section:34",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
      "parent": "act:chapter:viii",
      "provisionLevel": "section",
      "sectionNumber": 34,
      "title": "Crediting sums realised by way of penalties to Consolidated Fund of India",
      "sourcePages": {
        "start": 17,
        "end": 17
      },
      "extractedSourceText": "34. All sums realised by way of penalties imposed by the Board under this Act, shall\nbe credited to the Consolidated Fund of India.\nCHAPTER IX\nMISCELLANEOUS",
      "bodyText": "All sums realised by way of penalties imposed by the Board under this Act, shall\nbe credited to the Consolidated Fund of India.",
      "leadInText": "All sums realised by way of penalties imposed by the Board under this Act, shall be credited to the Consolidated Fund of India.",
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative",
      "crossReferences": []
    },
