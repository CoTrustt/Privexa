        {
          "value": 12,
          "unit": "month",
          "constraintType": "frequency",
          "sourcePhrase": "once in every period of twelve months"
        },
        {
          "value": 12,
          "unit": "month",
          "constraintType": "from_date",
          "sourcePhrase": " once in every period of twelve months from the date"
        }
      ],
      "categories": [
