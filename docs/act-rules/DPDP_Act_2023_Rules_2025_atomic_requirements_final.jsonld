    {
      "@id": "rule:2",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-rules-2025",
      "provisionLevel": "rule",
      "ruleNumber": 2,
      "title": "Definitions",
      "sourcePages": {
        "start": 1,
        "end": 1
      },
      "extractedSourceText": "2. Definitions. — (1) In these rules, unless the context otherwise requires, –\n(a) “Act” means the Digital Personal Data Protection Act, 2023 (22 of 2023);\n(b) “techno-legal measures” means as referred to under rules 20 and 22;\n(c) “user account” means the online account registered by the Data Principal with the Data Fiduciary, and\nincludes any profiles, pages, handles, email address, mobile number and other similar presences by means\nof which such Data Principal is able to access the services of such Data Fiduciary; and\n(d) “verifiable consent” means a consent as specified in rule 10 or 11.\n(2) The words and expressions used in these rules and not defined, but defined in the Act, shall have the\nsame meanings respectively assigned to them in the Act.",
      "bodyText": "(1) In these rules, unless the context otherwise requires, –\n(a) “Act” means the Digital Personal Data Protection Act, 2023 (22 of 2023);\n(b) “techno-legal measures” means as referred to under rules 20 and 22;\n(c) “user account” means the online account registered by the Data Principal with the Data Fiduciary, and\nincludes any profiles, pages, handles, email address, mobile number and other similar presences by means\nof which such Data Principal is able to access the services of such Data Fiduciary; and\n(d) “verifiable consent” means a consent as specified in rule 10 or 11.\n(2) The words and expressions used in these rules and not defined, but defined in the Act, shall have the\nsame meanings respectively assigned to them in the Act.",
      "leadInText": "",
      "commencement": {
        "basis": "Rule 1",
        "effectiveDateDerived": "2025-11-13"
      },
      "implementsOrOperationalises": [
        "act:section:2",
        "act:section:40"
      ],
      "delegationBasis": [
        "act:section:40:subsection:1"
      ],
      "crossReferences": [
        {
          "referenceKind": "rule",
          "sourcePhrase": "rules 20",
          "targetDocument": "doc:dpdp-rules-2025",
          "target": "rule:20",
          "resolutionStatus": "internal-resolved-root",
          "context": "(b) “techno-legal measures” means as referred to under rules 20 and 22;"
        },
        {
          "referenceKind": "rule",
          "sourcePhrase": "rule 10",
          "targetDocument": "doc:dpdp-rules-2025",
          "target": "rule:10",
          "resolutionStatus": "internal-resolved-root",
          "context": "and (d) “verifiable consent” means a consent as specified in rule 10 or 11."
        }
      ],
      "textStatus": "PDF-extracted; Gazette PDF remains authoritative"
    },
    {
      "@id": "rule:2:subrule:1",
