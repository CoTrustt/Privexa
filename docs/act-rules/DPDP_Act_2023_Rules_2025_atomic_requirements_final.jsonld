      "sourceText": "be an individual responsible to the Board of Directors or similar\ngoverning body of the Significant Data Fiduciary; and",
      "crossReferences": []
    },
    {
      "@id": "act:section:10:subsection:2:clause:a:subclause:iv",
      "@type": "dpdp:LegalProvision",
      "document": "doc:dpdp-act-2023",
