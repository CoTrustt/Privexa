POSTGRES_DB=privexa_dev
PRIVEXA_TEST_DB=privexa_test
POSTGRES_USER=privexa_owner
POSTGRES_PASSWORD=replace-with-a-local-owner-password
PRIVEXA_APP_DB_USER=privexa_app
PRIVEXA_APP_DB_PASSWORD=replace-with-a-local-app-password
DATABASE_URL=postgresql+psycopg://privexa_owner:replace-with-a-local-owner-password@localhost:5432/privexa_dev

# API runtime (use the non-owner role so PostgreSQL RLS remains effective)
APP_DATABASE_URL=postgresql+psycopg://privexa_app:replace-with-a-local-app-password@localhost:5432/privexa_dev
PRIVEXA_ENVIRONMENT=development
PRIVEXA_WEB_ORIGIN=http://localhost:3000
PRIVEXA_AUTH_COOKIE_DOMAIN=
STYTCH_PROJECT_ID=project-test-replace-me
STYTCH_SECRET=secret-test-replace-me

# Internal AI Gateway (disabled by default; provider credentials remain server-side)
AI_GATEWAY_ENABLED=false
# disabled | deterministic (development/test only) | openrouter
AI_PROVIDER_MODE=disabled
OPENROUTER_API_KEY=
AI_SYNTHETIC_TEXT_SUMMARY_MODEL=
AI_PREPARE_WORK_NOTE_MODEL=
AI_APPROVED_OPENROUTER_MODELS=[]
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_PROMPT_PRICE_USD_PER_MILLION_TOKENS=1.00
AI_MAX_COMPLETION_PRICE_USD_PER_MILLION_TOKENS=5.00
AI_MAX_COST_USD_PER_REQUEST=0.50
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_FAILURE_WINDOW_SECONDS=60
AI_CIRCUIT_OPEN_SECONDS=30
AI_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=2
AI_CIRCUIT_PROBE_LEASE_SECONDS=10

# Private S3-compatible object storage (local development uses MinIO)
MINIO_ROOT_USER=privexa-local-admin
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=privexa-development
TEST_OBJECT_STORAGE_BUCKET=privexa-test
OBJECT_STORAGE_ACCESS_KEY=privexa-local-app
OBJECT_STORAGE_SECRET_KEY=replace-with-a-different-local-app-password
OBJECT_STORAGE_ADDRESSING_STYLE=path
FILE_UPLOAD_URL_TTL_SECONDS=900
FILE_UPLOAD_COMPLETION_GRACE_SECONDS=300
FILE_DOWNLOAD_URL_TTL_SECONDS=120
MAX_FILE_UPLOAD_SIZE_BYTES=52428800

# Pytest only. The test harness refuses databases whose names do not end in `_test`.
TEST_DATABASE_URL=postgresql+psycopg://privexa_owner:replace-with-a-local-owner-password@localhost:5432/privexa_test
TEST_APP_DATABASE_URL=postgresql+psycopg://privexa_app:replace-with-a-local-app-password@localhost:5432/privexa_test

# Web runtime
PRIVEXA_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-replace-me
# Set only after configuring a Stytch custom domain, required for HttpOnly cookies in production.
NEXT_PUBLIC_STYTCH_CUSTOM_BASE_URL=
NEXT_PUBLIC_STYTCH_SESSION_DURATION_MINUTES=480

# Authenticated development-only professional-object UI harness. Production always returns 404.
PRIVEXA_UI_HARNESS_ENABLED=false
PRIVEXA_E2E_AUTH_BYPASS=false
